---
// Contact form with no backend: on submit it opens the visitor's own email app
// with a message to `company.contactEmail` already filled in. Nothing is sent
// until they press send there, and nothing is stored on our side.
import { company } from '../data/site';

interface Props {
  id: string;
}
const { id } = Astro.props;
---

<form
  class="contact-form"
  action={`mailto:${company.contactEmail}`}
  method="post"
  enctype="text/plain"
  data-contact-email={company.contactEmail}
>
  <label for={`${id}-name`}>Your Name <span class="req">(required)</span></label>
  <input id={`${id}-name`} type="text" name="name" autocomplete="name" required />

  <label for={`${id}-company`}>Your Company <span class="req">(required)</span></label>
  <input id={`${id}-company`} type="text" name="company" autocomplete="organization" required />

  <label for={`${id}-email`}>Your Email <span class="req">(required)</span></label>
  <input id={`${id}-email`} type="email" name="email" autocomplete="email" required />

  <label for={`${id}-topic`}>Subject</label>
  <input id={`${id}-topic`} type="text" name="topic" />

  <label for={`${id}-message`}>Your Message</label>
  <!-- Capped because very long mailto links get cut off by some email apps. -->
  <textarea id={`${id}-message`} name="message" rows="6" maxlength="1500"></textarea>

  <button type="submit" class="button">Send</button>

  <p class="form-note" role="status" hidden>
    Your email app should now open with your message ready to send. If it didn't,
    <a href={`mailto:${company.contactEmail}`}>click here to try again</a> or call
    <a href={company.tollFreeHref}>{company.tollFree}</a>.
  </p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('.contact-form').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const field = (name: string) => String(data.get(name) ?? '').trim();

      const subject = field('topic') || `Website inquiry from ${field('name')}`;
      const body = [
        `Name: ${field('name')}`,
        `Company: ${field('company')}`,
        `Email: ${field('email')}`,
        '',
        field('message'),
      ].join('\r\n');
      const href = `mailto:${form.dataset.contactEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;

      const note = form.querySelector<HTMLElement>('.form-note');
      note?.querySelector('a')?.setAttribute('href', href);
      if (note) note.hidden = false;
      location.href = href;
    });
  });
</script>
